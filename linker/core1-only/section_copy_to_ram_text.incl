/* Project override of the Pico SDK's own
 * pico_standard_link/script_include/section_copy_to_ram_text.incl, added to
 * the build ONLY for the core-1-pinned configuration (see the
 * MEML_MLP_RUNS_ON_CORE STREQUAL "1" guard around this override in
 * CMakeLists.txt) -- core 0 and the unpinned build never see this file, and
 * keep using the SDK's own unmodified copy.
 *
 * Lives in its own linker/core1-only/ subdirectory rather than linker/
 * itself: pico_add_linker_script_override_path adds its whole path argument
 * to the linker's INCLUDE search path, not just the FILES named in one
 * particular call, so a same-named override placed directly in linker/
 * (already unconditionally on the search path for both pinned configs)
 * would resolve for core 0 too and wrongly redirect ITS for_each_layer
 * instantiations into CORE1_RAM as well -- confirmed by hitting exactly
 * that failure (validate_memory_placement.py caught it) before moving this
 * file here.
 *
 * Purpose: two kinds of hot-path code can never carry an explicit `section`
 * attribute of their own, and so land in this redirect instead of the
 * ordinary catch-all below:
 *
 *   1. mlp/StaticMLP.h's for_each_layer<F, I> (a member function template
 *      instantiated many times per translation unit with genuinely
 *      different closure types F) -- see its comment in mlp/StaticMLP.h --
 *      which relies on -ffunction-sections giving each instantiation its
 *      own safely-unique auto-named `.text._ZN...` section instead.
 *   2. CMSIS-DSP's arm_dot_prod_f32(), pulled in from
 *      CMSISDSP_dotprod (see CMakeLists.txt) to serve StaticLayer.h's
 *      ARM_MATH_CM33 branch. It is third-party code with no SMLP_CODE_ATTR
 *      hook at all, but forward() calls it on every dot product once that
 *      branch is active, so it is just as much on the hot path as
 *      for_each_layer -- and just as untagged. Matched by archive member
 *      below rather than by mangled-name substring, since it's plain C with
 *      no template instantiations to disambiguate.
 *
 * For the unpinned build and the core-0-pinned build this redirect isn't
 * needed: the SDK's own default RAM window IS core 0's bank, so both kinds
 * of untagged code land in the right place for free via the ordinary
 * catch-all below. Core 1's bank (CORE1_RAM) is a genuinely separate region
 * that the unmodified catch-all can never reach: GNU ld claims each input
 * section via the FIRST output-section rule (in the fully-assembled
 * script's text order) whose wildcard matches it, and there is no way to
 * exclude a section-name pattern from an already-matching wildcard -- so
 * reaching CORE1_RAM requires a rule that appears BEFORE the catch-all,
 * which is exactly what this override adds.
 *
 * Safety of the wildcard matches below: the for_each_layer one matches on
 * the mangled-name substring "for_each_layer" (stable across every
 * instantiation -- Itanium mangling embeds the literal identifier text,
 * just prefixed by its length and followed by template arguments). This can
 * never accidentally fold two different instantiations together the way an
 * explicit, textually-shared `section` attribute would: -ffunction-sections
 * already gives each instantiation its own distinct symbol/section name, so
 * this wildcard only ever redirects sections that were already one-to-one
 * with a single symbol. The CMSISDSP_dotprod one matches by archive member
 * name, which is exact and can't accidentally catch anything else linked
 * into the image.
 *
 * Boot safety: this project uses `copy_to_ram` binaries. In that binary
 * type the vector table lives in its own `.flashtext` output section
 * (section_copy_to_ram_flashtext.incl), textually and positionally separate
 * from the `.text*` catch-all below (section_copy_to_ram_text.incl) --
 * unlike the plain "flash" binary type's section_default_text.incl, where
 * the two share one output-section block. Both `.flashtext` and `.boot2`
 * are already placed in flash by earlier fragments
 * (sections_copy_to_ram_text.incl's own include order: section_flash_begin,
 * section_copy_to_ram_flashtext, section_boot2, section_copy_to_ram_rodata,
 * ..., THEN this file) before this file is ever reached, so inserting a new
 * output section ahead of the catch-all here cannot land before the vector
 * table in flash -- confirmed by inspecting the resulting .elf/.bin's flash
 * layout directly (readelf -SW; the first flash bytes still decode as a
 * valid ARM vector table) before this was ever handed off for a hardware
 * run.
 *
 * Below the redirect block, this file must stay identical to the SDK's own
 * section_copy_to_ram_text.incl, so that upgrading the SDK only requires
 * re-diffing this one file.
 */

SECTIONS
{
    .time_critical.core1.untagged_hotpath : ALIGN(8)
    {
        __core1_untagged_hotpath_start__ = .;
        *(.text.*for_each_layer*)
        *libCMSISDSP_dotprod.a:*(.text*)
        . = ALIGN(8);
        __core1_untagged_hotpath_end__ = .;
    } > CORE1_RAM AT> RAM_STORE

    /* Like .time_critical.core1.code's own __core1_code_load__
     * (section_extra_post_text.incl): this section's VMA (CORE1_RAM) differs
     * from its LMA (flash), so `copy_to_ram`'s normal startup copy -- which
     * only knows about the SDK's own .text/.data tables -- never touches it.
     * memory/CoreSectionInit.cpp's meml_core1_preinit() copies it explicitly,
     * using this symbol, before any constructor (and hence any code that
     * could call into it) runs.
     */
    __core1_untagged_hotpath_load__ = LOADADDR(.time_critical.core1.untagged_hotpath);

    ASSERT((__core1_untagged_hotpath_end__ <= 0x2007fff0),
        "core1 untagged-hotpath redirect exceeds the 256 KiB SRAM bank")
}

/* ── Unmodified copy of the SDK's section_copy_to_ram_text.incl below ── */

/* Defines the following symbols for use by code:
    __ram_text_start__, __ram_text_end__, __ram_text_source__
*/

SECTIONS
{
    .text : {
        __ram_text_start__ = .;
        *(.init)
        *(.text*)
        *(.fini)
        /* Pull all c'tors into .text */
        *crtbegin.o(.ctors)
        *crtbegin?.o(.ctors)
        *(EXCLUDE_FILE(*crtend?.o *crtend.o) .ctors)
        *(SORT(.ctors.*))
        *(.ctors)
        /* Followed by destructors */
        *crtbegin.o(.dtors)
        *crtbegin?.o(.dtors)
        *(EXCLUDE_FILE(*crtend?.o *crtend.o) .dtors)
        *(SORT(.dtors.*))
        *(.dtors)

        *(.eh_frame*)
        . = ALIGN(4);
        __ram_text_end__ = .;
    } > RAM AT> RAM_STORE
    __ram_text_source__ = LOADADDR(.text);
    . = ALIGN(4);
}
