/* Keep only the mutable core-1 bank as a NOLOAD allocation. The copied code lives in the
 * front of the bank, and the banked data/stack begins only after that code range so the
 * bootstrap can copy code and then safely zero the mutable state without erasing its own
 * executable payload.
 */
SECTIONS
{
    .flash : ALIGN(8)
    {
        __meml_flash_data_start__ = .;
        *(.flash)
        . = ALIGN(8);
        __meml_flash_data_end__ = .;
    } > FLASH

    .core1_bank (NOLOAD) : ALIGN(8)
    {
        __core1_bank_start__ = .;
        *(.core1.bank)
        . = ALIGN(8);
        __core1_bank_end__ = .;
    } > CORE1_RAM

    .core1_stack (NOLOAD) : ALIGN(8)
    {
        __core1_stack_bottom__ = .;
        . += 4K;
        __core1_stack_top__ = .;
    } > CORE1_RAM

    /* Explicit, checked home for MEML_DATA_ON_CORE(0) state, symmetric with the
     * core-1 bank above. Without this, .core0.bank still lands correctly in the
     * default 256 KiB RAM region via ld's orphan-section placement, but that
     * placement is implicit and unverifiable from the ELF map; this makes it an
     * explicit, ASSERT-guarded guarantee instead.
     *
     * Aligned to 64 KiB (one RP2350 SRAM bank) rather than just 8 bytes: with
     * only byte alignment, this section starts wherever .text/.data/.bss
     * happen to end, so mlp_experiment_ (the MLP's ~95 KiB weight/activation
     * state, the dominant occupant of this bank) can straddle two SRAM bank
     * boundaries instead of one. Measured on hardware as build-core0's
     * remaining timing gap against build-core1/build-naive after the .text
     * placement fix (see linker/core0-only/section_copy_to_ram_text.incl):
     * core-1's equivalent bank starts right after its own small copied-code
     * header, and the unpinned build's equivalent object also lands with only
     * one crossing, so core 0 was the outlier. Bank-aligning this section's
     * start gives mlp_experiment_ the same one-crossing-or-fewer layout the
     * other two builds already have.
     */
    .core0_bank (NOLOAD) : ALIGN(0x10000)
    {
        __core0_bank_start__ = .;
        *(.core0.bank)
        . = ALIGN(8);
        __core0_bank_end__ = .;
    } > RAM

    ASSERT((__core1_code_end__ <= __core1_bank_start__), "core1 copied code overlaps the mutable bank region")
    ASSERT((__core1_bank_end__ <= 0x20080000), "core1 bank overflowed 256 KiB SRAM window")
    ASSERT((__core1_stack_top__ <= 0x20080000), "core1 stack overflowed 256 KiB SRAM window")
    ASSERT((__core0_bank_start__ >= 0x20000000), "core0 bank underflowed the default 256 KiB SRAM window")
    ASSERT((__core0_bank_end__ <= 0x20040000), "core0 bank overflowed the default 256 KiB SRAM window")
}
