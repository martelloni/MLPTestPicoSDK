/* Keep only the core-1 banked SRAM as a NOLOAD allocation. Core 0 already owns the
 * default SRAM region on RP2350; forcing it through an extra NOLOAD mapping creates a
 * UF2-invalid initialized-data placement. Any core-private runtime state must be zeroed at
 * start-up rather than stored as flash-backed init data in the bank region.
 */
SECTIONS
{
    .core1_bank (NOLOAD) : ALIGN(8)
    {
        __core1_bank_start__ = .;
        *(.core1.bank)
        . = ALIGN(8);
        __core1_bank_end__ = .;
    } > CORE1_RAM

    .core1_stack (NOLOAD) : ALIGN(8)
    {
        __core1_stack_bottom__ = .;
        . += 4K;
        __core1_stack_top__ = .;
    } > CORE1_RAM
}
