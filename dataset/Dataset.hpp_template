#ifndef __DATASET_HPP__
#define __DATASET_HPP__

#include <array>
#include <cstddef>
#include "MemoryDefs.hpp"

namespace dataset {

constexpr std::size_t kFeatureSize = %FEATURE_SIZE%;
constexpr std::size_t kLabelSize = %LABEL_SIZE%;
constexpr std::size_t kNumExamples = %NUM_EXAMPLES%;
using DataType = %DATA_TYPE%;

extern const std::array<std::array<DataType, kFeatureSize>, kNumExamples> features;
extern const std::array<std::array<DataType, kLabelSize>, kNumExamples> labels;

};  // namespace dataset

#endif // __DATASET_HPP__
